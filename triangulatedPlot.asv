% Load and filter the data
data = readtable("triangulated_points_newt.csv");
timestamps = data.timestamp;
positions = [data.x, data.y, data.z];

% Keep only points with valid depth
valid = positions(:,3) > 0 & positions(:,3) < 3000;
positions = positions(valid, :);
timestamps = timestamps(valid);

% Time binning (1 ms tick steps)
binnedTimestamps = round(timestamps / 1e4);  % round timestamps to 1 ms bins
timeBins = unique(binnedTimestamps);        % list of unique time bins

% Reorder into camera coordinate frame:
% Z (forward), X (right), Y (down)
positions = [positions(:,3), -positions(:,1), -positions(:,2)];

% Axis limits in camera space
lims = struct('x', [-1, 1], 'y', [-1, 1], 'z', [0, 2]);

% Set up figure
figure;
h = scatter3(nan, nan, nan, 16, 'filled');
xlabel('Z (depth)');
ylabel('X (right)');
zlabel('Y (down)');
xlim(lims.x); ylim(lims.y); zlim(lims.z);
axis manual; view(3); grid on;

% Animate
for i = 1:length(timeBins)
    idx = binnedTimestamps == timeBins(i); 
    pts = positions(idx, :);
    if ~isempty(pts)
        set(h, 'XData', pts(:,1), ...
               'YData', pts(:,2), ...
               'ZData', pts(:,3));
        title(sprintf("Time: %.2f ms", timeBins(i)));
        pause(0.5);
    end
end

